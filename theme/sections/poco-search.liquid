{%- unless request.page_type == 'search' -%}
<section class="poco-search page-width" aria-labelledby="PocoSearchLabel-{{ section.id }}">
  <form action="{{ routes.search_url }}" method="get" role="search">
    <div class="poco-search__field">
      <label class="visually-hidden" id="PocoSearchLabel-{{ section.id }}" for="PocoSearch-{{ section.id }}">{{ 'poco.search.label' | t }}</label>
      <input id="PocoSearch-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" style="width:100%">
      <input type="hidden" name="type" value="product">
    </div>
    <button class="poco-search__button" type="submit" aria-label="{{ 'general.search.search' | t }}">
      {% render 'icon-search' %}
    </button>
  </form>
</section>
{%- endunless -%}
{% schema %}
{"name":"Poco: búsqueda visible","settings":[],"presets":[{"name":"Poco: búsqueda visible"}]}
{% endschema %}
